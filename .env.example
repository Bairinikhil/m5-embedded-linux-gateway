# Plain MQTT (current default)
MQTT_HOST=192.168.1.156
MQTT_PORT=1883
MQTT_TOPIC=devices/+/health
MQTT_TLS=false

# For the secure Mosquitto broker, use local absolute paths and set:
# MQTT_PORT=8883
# MQTT_TLS=true
# MQTT_TLS_CA=/path/to/ca.crt
# MQTT_TLS_CERT=/path/to/observer.crt
# MQTT_TLS_KEY=/path/to/observer.key
